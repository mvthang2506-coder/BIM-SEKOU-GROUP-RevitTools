<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Autojoin/Unjoin - Kết quả"
        Width="430"
        Height="320"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="28,24,28,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="CheckText"
                   Grid.Row="0"
                   Text="✓"
                   FontSize="48"
                   FontWeight="Bold"
                   Foreground="Green"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

        <TextBlock Grid.Row="1"
                   Text="Autojoin đã chạy thành công"
                   FontSize="18"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,4,0,18"/>

        <TextBlock x:Name="ScopeText"
                   Grid.Row="2"
                   FontSize="14"
                   Margin="0,0,0,8"/>

        <TextBlock x:Name="CountText"
                   Grid.Row="3"
                   FontSize="14"
                   Margin="0,0,0,14"/>

        <Button x:Name="OkButton"
                Grid.Row="4"
                Content="OK"
                Width="75"
                Height="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"/>
    </Grid>
</Window>
