<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Autojoin/Unjoin"
        Width="820" Height="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    <Grid Margin="12">
        <TabControl>
            <TabItem Header="Autojoin/Unjoin">
                <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Phạm vi:" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="0,0,15,0"/>
            <RadioButton x:Name="CurrentViewRadio" Content="Current View"
                         IsChecked="True" Margin="0,0,18,0"
                         VerticalAlignment="Center"/>
            <RadioButton x:Name="EntireProjectRadio" Content="Entire Project"
                         VerticalAlignment="Center"/>
            <Button x:Name="RefreshButton" Content="Refresh Category"
                    Width="135" Height="28" Margin="25,0,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#BFBFBF" BorderThickness="1"
                Padding="8" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Thiết lập" FontWeight="Bold"
                           Margin="0,0,0,5"/>
                <TextBlock Text="✓ Chỉ xử lý các đối tượng có Solid thực tế giao nhau"/>
                <TextBlock Text="Category không tồn tại trong phạm vi đã chọn sẽ không xuất hiện."
                           Foreground="#666666" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="CATEGORY ĐÃ CHỌN — PRIORITY"
                   FontWeight="Bold" Margin="2,3,0,5"/>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1.2*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="#BFBFBF" BorderThickness="1"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="#EDEDED">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="45"/>
                            <ColumnDefinition Width="55"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="STT" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Chọn" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="Category" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBlock Grid.Column="3" Text="Priority" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="Đổi" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SelectedCategoryPanel"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <TextBlock Grid.Row="1" x:Name="AvailableCountText"
                       Text="Chưa chọn: 0" FontWeight="Bold"
                       Margin="2,0,0,5"/>

            <Border Grid.Row="2" BorderBrush="#BFBFBF" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="#F5F5F5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="45"/>
                            <ColumnDefinition Width="55"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="STT" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Chọn" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="Category chưa chọn"
                                   FontWeight="Bold" VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>
                        <TextBlock Grid.Column="3" Text=""
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="AvailableCategoryPanel"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="SelectedCountText" Text="Đã chọn: 0"
                       VerticalAlignment="Center" Margin="0,0,20,0"/>
            <Button x:Name="SelectAllButton" Content="Chọn tất cả"
                    Width="100" Height="30" Margin="0,0,8,0"/>
            <Button x:Name="ClearAllButton" Content="Bỏ chọn"
                    Width="90" Height="30" Margin="0,0,20,0"/>
            <Button x:Name="RunButton" Content="RUN AUTOJOIN/UNJOIN"
                    Width="175" Height="34" Margin="0,0,8,0"/>
            <Button x:Name="CancelButton" Content="Cancel"
                    Width="90" Height="34"/>
        </StackPanel>
    </Grid>
            </TabItem>

        <TabItem Header="Join by Family">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Phạm vi:" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <RadioButton x:Name="FamilyCurrentViewRadio" Content="Current View"
                                 IsChecked="True" Margin="0,0,18,0"
                                 VerticalAlignment="Center"/>
                    <RadioButton x:Name="FamilyEntireProjectRadio" Content="Entire Project"
                                 VerticalAlignment="Center"/>
                </StackPanel>

                <Border Grid.Row="1" BorderBrush="#BFBFBF" BorderThickness="1"
                        Padding="8" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Thiết lập Join theo Family"
                                   FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBlock Text="✓ Chỉ xử lý các đối tượng có Solid thực tế giao nhau"/>
                        <TextBlock Text="Priority 1 = ưu tiên cao nhất"
                                   Foreground="#666666" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="#BFBFBF" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Background="#EDEDED">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="45"/>
                                    <ColumnDefinition Width="55"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="95"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="STT" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Chọn" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Family chưa chọn"
                                           FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <TextBlock Grid.Column="3" Text=""
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="FamilyAvailablePanel"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" BorderBrush="#BFBFBF" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Background="#EDEDED">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="45"/>
                                    <ColumnDefinition Width="55"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="95"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="STT" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Chọn" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Family đã chọn"
                                           FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <TextBlock Grid.Column="3" Text="Priority"
                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="Đổi"
                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="FamilySelectedPanel"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <StackPanel Grid.Row="3" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,10,0,0">
                    <TextBlock x:Name="FamilyAvailableCountText"
                               Text="Chưa chọn: 0"
                               VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <TextBlock x:Name="FamilySelectedCountText"
                               Text="Đã chọn: 0"
                               VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <Button x:Name="FamilyRunButton"
                            Content="RUN JOIN BY FAMILY"
                            Width="170" Height="34" Margin="0,0,8,0"/>
                </StackPanel>
            </Grid>
        </TabItem>

        </TabControl>
    </Grid>
</Window>
